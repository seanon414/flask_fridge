# Copy to .env (which is gitignored) and fill in. Read by the systemd units.

# Stable key for the web UI's CSRF tokens (python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=

# Push alerts via ntfy.sh. Pick a long random topic name and treat it like a
# password: anyone who knows it can read your alerts. Leave blank to turn alerts off.
# Then subscribe to the same topic in the ntfy app on your phone.
NTFY_TOPIC=

# Optional tuning (defaults shown)
#NTFY_SERVER=https://ntfy.sh
#ALERT_WARM_MARGIN=3          # degF above the band before "too warm" counts
#ALERT_COLD_MARGIN=3          # degF below the band before "too cold" counts
#ALERT_MINUTES=30             # how long a temperature problem must last
#ALERT_SENSOR_MINUTES=10
#ALERT_CONTROLLER_MINUTES=5
#ALERT_REMIND_HOURS=6
